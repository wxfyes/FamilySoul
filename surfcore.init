#!/bin/sh /etc/rc.common
# ========================================================
# OpenWrt / iStoreOS 原生系统守护服务 (PROCD)
# 安装方法:
#   cp surfcore.init /etc/init.d/surfcore
#   chmod +x /etc/init.d/surfcore
#   /etc/init.d/surfcore enable   (设置开机自启)
#   /etc/init.d/surfcore start    (启动服务)
# ========================================================

USE_PROCD=1
START=95
STOP=10

APP_DIR="/opt/surfcore-server"

start_service() {
    [ -d "$APP_DIR" ] || return 1

    procd_open_instance
    procd_set_param command /usr/bin/node "$APP_DIR/src/server.js"
    procd_set_param respawn 3600 5 0   # 异常退出时自动秒级拉起，永不宕机
    procd_set_param stdout 1           # 日志打入系统 logread
    procd_set_param stderr 1
    procd_set_param working_dir "$APP_DIR"
    procd_close_instance
}

stop_service() {
    killall node 2>/dev/null || true
}
